# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Public URL of the site (for OAuth redirects). Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Google AI Studio key for AI Team Builder (free tier). Without it a keyword fallback is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: GitHub token (no scopes) to raise the GitHub API rate limit from 60 to 5000 req/h
GITHUB_TOKEN=
